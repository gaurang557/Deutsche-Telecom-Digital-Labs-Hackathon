AGENT_APP_NAME=Voice desk
AGENT_APP_VERSION=0.1.0
AGENT_DEBUG=false
AGENT_WHISPER_MODEL=base.en
AGENT_WHISPER_COMPUTE_TYPE=int8
AGENT_WARM_WHISPER_ON_STARTUP=false
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=llama3.2

# Planner backend: ollama (default) or cursor.
# The Cursor path also needs the cursor-sdk extra and a CURSOR_API_KEY set in
# the shell environment. Never put the API key in this file.
#AGENT_LLM_PROVIDER=ollama
#AGENT_CURSOR_MODEL=composer-2.5
