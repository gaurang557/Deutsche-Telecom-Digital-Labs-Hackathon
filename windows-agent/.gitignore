# Self-contained ignore rules for the windows-agent module, so its build/test
# artifacts never touch the shared source folder or other teammates' entities.
__pycache__/
*.pyc
.pytest_cache/
.venv/
audit.log.jsonl
artifacts/
*.egg-info/
.env

# Manual-testing scratch area (tools/manual_file_test.py) — never tracked.
sandbox/

# Kept local only (not tracked in git) — maintained on-disk, shared out-of-band.
CHANGES.md
docs/WALKTHROUGH.md
docs/ARCHITECTURE.md
